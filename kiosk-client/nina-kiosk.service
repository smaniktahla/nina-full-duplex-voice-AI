# Nina kiosk voice client: install as ~/.config/systemd/user/nina-kiosk.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now nina-kiosk.service
# (loginctl enable-linger <user> so it starts at boot even before anyone logs in)
[Unit]
Description=Nina kiosk voice client
After=pipewire.service pipewire-pulse.service wireplumber.service network-online.target
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=%h/nina-kiosk/src/kiosk-client
# the PipeWire echo-cancelled nodes (pipewire-echo-cancel.conf); PortAudio's "pulse" device honours these
Environment=PULSE_SOURCE=nina_ec_source PULSE_SINK=nina_ec_sink
ExecStart=%h/nina-kiosk/venv/bin/python nina_kiosk.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

[Unit]
Description=kiosk-page-fade: fade between dashboards
After=display-manager.service

[Service]
User=kiosk
Environment=KIOSK_EFFECTS_URL=http://HOME_ASSISTANT_HOST:8123/local/kiosk_effects.json
Environment=KIOSK_ID=BROWSER_MOD_ID
ExecStart=/usr/bin/python3 /usr/local/bin/kiosk-page-fade.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
